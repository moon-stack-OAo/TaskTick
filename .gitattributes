# 默认：文本按内容检测，检出/入库统一 LF（跨平台 diff 稳定）
* text=auto eol=lf

# Windows 批处理需 CRLF 才能在 cmd.exe 下可靠运行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制（禁止被当成文本做换行转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pdb binary
*.snk binary
*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary
